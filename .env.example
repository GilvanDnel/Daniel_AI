ADMIN_PASSWORD=defina_uma_senha_forte

# Caminho do banco vetorial (ChromaDB)
CHROMA_DB_PATH=./chroma_db

# Caminho da base de documentos corporativos
COMPANY_DOCS_PATH=./company_docs
